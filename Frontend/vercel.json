{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "destination": "/dist/index.html"
    },
    {
      "source": "/ide",
      "destination": "/ide.html"
    },
    {
      "source": "/app",
      "destination": "/ide.html"
    },
    {
      "source": "/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/presentation",
      "destination": "/presentation.html"
    },
    {
      "source": "/cyber",
      "destination": "/cyber.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/dist/assets/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
